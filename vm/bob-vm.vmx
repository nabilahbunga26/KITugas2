.encoding = "UTF-8"
config.version = "8"
virtualHW.version = "20"
displayName = "BOB-ksi"
guestOS = "linux"
memsize = "1024"
numvcpus = "1"
cpuid.coresPerSocket = "1"
firmware = "bios"
bios.bootOrder = "cdrom"
bios.bootDelay = "3000"

# jaringan: VMware NAT (VMnet8, 192.168.59.0/24) -> VM dapat IP 192.168.59.x + internet
ethernet0.present = "TRUE"
ethernet0.virtualDev = "e1000"
ethernet0.connectionType = "nat"
ethernet0.addressType = "generated"
ethernet0.startConnected = "TRUE"

# boot dari ISO Alpine (live, tidak di-install)
ide1:0.present = "TRUE"
ide1:0.deviceType = "cdrom-image"
ide1:0.fileName = "alpine-virt.iso"
ide1:0.startConnected = "TRUE"

ide0:0.present = "TRUE"
ide0:0.deviceType = "disk"
ide0:0.fileName = "bob-disk.vmdk"
ide0:0.startConnected = "TRUE"

floppy0.present = "FALSE"
usb.present = "FALSE"
sound.present = "FALSE"
svga.vramSize = "268435456"
tools.syncTime = "FALSE"
tools.upgrade.policy = "useGlobal"

# supaya teks bisa di-paste dari Windows ke konsol VM saat demo
isolation.tools.copy.disable = "FALSE"
isolation.tools.paste.disable = "FALSE"
extendedConfigFile = "bob-vm.vmxf"
vmxstats.filename = "bob-vm.scoreboard"
numa.autosize.cookie = "10012"
numa.autosize.vcpu.maxPerVirtualNode = "1"
uuid.bios = "56 4d 70 11 81 40 69 45-07 aa e7 6b 2f cf 46 82"
uuid.location = "56 4d 70 11 81 40 69 45-07 aa e7 6b 2f cf 46 82"
ethernet0.pciSlotNumber = "16"
ide0:0.redo = ""
vmotion.checkpointFBSize = "4194304"
vmotion.checkpointSVGAPrimarySize = "268435456"
vmotion.svga.mobMaxSize = "268435456"
vmotion.svga.graphicsMemoryKB = "262144"
ethernet0.generatedAddress = "00:0c:29:cf:46:82"
ethernet0.generatedAddressOffset = "0"
monitor.phys_bits_used = "45"
vm.lastPowerRequestTimestamp = "1793101547996000"
cleanShutdown = "FALSE"
softPowerOff = "FALSE"
virtualHW.productCompatibility = "hosted"
svga.guestBackedPrimaryAware = "TRUE"

# supaya skrip bisa mengetik ke konsol (raw keyboard dimatikan)
mks.enableRawKb = "FALSE"
