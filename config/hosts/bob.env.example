# Perangkat: Bob = VM Alpine di VMware Workstation (NAT / VMnet8)  ->  python -m src.bob.main
# VM tidak bisa menjangkau WSL (KDC) langsung, jadi KDC dibuka lewat portproxy di host:
#   powershell -ExecutionPolicy Bypass -File scripts\vm\iziin-bob.ps1   (harus ADMIN, sekali saja)
KDC_IP=192.168.59.1
KDC_PORT=4444
CHAT_PORT=5555
PEER_NAME=ALICE
PEER_IP=
# IP VM sendiri; tiap boot berubah, jadi mulai-bob.sh mengisinya otomatis lewat --advertise-ip
ADVERTISE_IP=192.168.59.10
MASTER_KEY=KbsMasterKeyBBBB
LOG_FILE=captures/bob.log
